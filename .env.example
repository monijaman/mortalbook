# ====================================
# GLOBAL ENVIRONMENT VARIABLES
# ====================================

# Application Environment
APP_ENV=development
APP_NAME=mortalbook
LOG_LEVEL=debug

# ====================================
# DATABASE
# ====================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=mortalbook_db
DB_USER=postgres
DB_PASSWORD=postgres_dev_password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ====================================
# REDIS
# ====================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ====================================
# KAFKA
# ====================================
KAFKA_BROKERS=kafka:9092
KAFKA_GROUP_ID=mortalbook-group
KAFKA_ZOOKEEPER=zookeeper:2181

# ====================================
# MEMORIAL SERVICE (Go gRPC)
# ====================================
MEMORIAL_SERVICE_PORT=5001
MEMORIAL_SERVICE_GRPC_PORT=50001
MEMORIAL_SERVICE_DEBUG=true

# ====================================
# ADMIN SERVICE (FastAPI)
# ====================================
ADMIN_SERVICE_PORT=5002
ADMIN_SERVICE_DEBUG=true
ADMIN_SERVICE_SECRET_KEY=your-secret-key-change-in-production

# ====================================
# FRONTEND (Next.js)
# ====================================
NEXT_PUBLIC_API_URL=http://localhost:5001
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:5002
NEXT_PUBLIC_APOLLO_ENDPOINT=http://localhost:4000/graphql
NEXT_PUBLIC_SITE_NAME=Mortalbook
NEXT_PUBLIC_SITE_DESCRIPTION=A memorial site to honor those we've lost

# ====================================
# ADMIN PANEL (Vue 3)
# ====================================
VUE_APP_API_URL=http://localhost:5002
VUE_APP_MEMORIAL_API_URL=http://localhost:5001
VUE_APP_ADMIN_TOKEN=your-admin-token-here

# ====================================
# AWS/S3 (Optional)
# ====================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=mortalbook-memorial-media

# ====================================
# AUTHENTICATION
# ====================================
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRATION=86400
REFRESH_TOKEN_EXPIRATION=604800
